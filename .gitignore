# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# 🛑 SECRETS & ENVIRONMENTS (NON COMMITTARE MAI)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# (Puoi committare .env.example o .env.template se li crei per mostrare le variabili necessarie)

# ==========================================
# ⚡ CLOUDFLARE, WRANGLER & OPENNEXT
# ==========================================
.vercel
.open-next
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# ==========================================
# 🗄️ DATABASE (PRISMA & CLOUDFLARE D1)
# ==========================================
# Ignora i database SQLite locali generati da Prisma o D1 durante lo sviluppo
*.db
*.db-journal
*.sqlite
*.sqlite3

# typescript
*.tsbuildinfo
next-env.d.ts